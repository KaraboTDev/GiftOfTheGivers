@model GiftOfTheGivers.Models.ReliefProjects

<h2>Post a Relief Project Update</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ProjectName"></label>
        <input asp-for="ProjectName" class="form-control" />
        <span asp-validation-for="ProjectName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProjectDescription"></label>
        <textarea asp-for="ProjectDescription" class="form-control"></textarea>
        <span asp-validation-for="ProjectDescription" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProjectDisasterType"></label>
        <select asp-for="ProjectDisasterType" asp-items="Html.GetEnumSelectList<GiftOfTheGivers.Models.DisasterType>()" class="form-control"></select>
        <span asp-validation-for="ProjectDisasterType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<GiftOfTheGivers.Models.CurrentStatus>()" class="form-control"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FundingTarget"></label>
        <input asp-for="FundingTarget" class="form-control" />
        <span asp-validation-for="FundingTarget" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NumberOfBeneficiaries"></label>
        <input asp-for="NumberOfBeneficiaries" class="form-control" />
        <span asp-validation-for="NumberOfBeneficiaries" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Post Update</button>
</form>
