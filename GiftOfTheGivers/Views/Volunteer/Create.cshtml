@model GiftOfTheGivers.Models.Volunteer

<h2>Volunteer Registration</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-4">
        <label for="skills-select" class="form-label">Skills</label>
        <select id="skills-select" name="SelectedSkillIds" multiple class="form-select">
            @foreach (var skill in (List<GiftOfTheGivers.Models.Skill>)ViewBag.AllSkills)
            {
                <option value="@skill.Id">@skill.Name</option>
            }
        </select>
    </div>

    <div class="mb-4">
        <label class="form-label d-block">When are you available?</label>
        <div id="availability-rows">
            <div class="availability-row row g-2 align-items-end mb-2">
                <div class="col-auto">
                    <label class="form-label small">From</label>
                    <input type="text" class="form-control availability-date" name="AvailabilityStart" placeholder="Start date" />
                </div>
                <div class="col-auto">
                    <label class="form-label small">To</label>
                    <input type="text" class="form-control availability-date" name="AvailabilityEnd" placeholder="End date" />
                </div>
                <div class="col-auto">
                    <label class="form-label small">Note (optional)</label>
                    <input type="text" class="form-control" name="AvailabilityNote" placeholder="e.g. weekends only" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-danger remove-row" title="Remove">&times;</button>
                </div>
            </div>
        </div>
        <button type="button" id="add-availability-row" class="btn btn-sm btn-outline-primary">
            + Add another availability period
        </button>
    </div>

    <div class="form-group">
        <label asp-for="EmergencyContactName"></label>
        <input asp-for="EmergencyContactName" class="form-control" />
        <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EmergencyContactPhone"></label>
        <input asp-for="EmergencyContactPhone" class="form-control" />
        <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MedicalConditions"></label>
        <input asp-for="MedicalConditions" class="form-control" />
        <span asp-validation-for="MedicalConditions" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="YearsOfExperience"></label>
        <input asp-for="YearsOfExperience" class="form-control" />
        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaxTravelDistance"></label>
        <input asp-for="MaxTravelDistance" class="form-control" />
        <span asp-validation-for="MaxTravelDistance" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LanguagesSpoken"></label>
        <input asp-for="LanguagesSpoken" class="form-control" />
        <span asp-validation-for="LanguagesSpoken" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/volunteer-form.js" asp-append-version="true"></script>
}
